# Telegram
BOT_TOKEN=your-telegram-bot-token
GROUP_CHAT_ID=-1001234567890

# Zenobank
ZENOBANK_API_KEY=your-zenobank-api-key
ZENOBANK_WEBHOOK_SECRET=your-zenobank-webhook-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot

# Admin (comma-separated Telegram user IDs, first is primary admin)
ADMIN_TELEGRAM_IDS=123456789

# Server
PORT=3000
